{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "catalogo-autos-api",
	"main": "src/index.ts",
	"compatibility_date": "2024-01-01",
	"d1_databases": [
		{
			"binding": "bd_autos",
			"database_name": "bd-autos",
			"database_id": "eae76039-d27a-4a51-bd4a-f6202cd03f04"
		}
	],
	"r2_buckets": [
		{
			"binding": "DATOS_BUCKET",
			"bucket_name": "datos-autos"
		}
	],
	// 👇 Agrega esta sección para producción
	"env": {
		"production": {
			"d1_databases": [
				{
					"binding": "bd_autos",
					"database_name": "bd-autos",
					"database_id": "eae76039-d27a-4a51-bd4a-f6202cd03f04"
				}
			],
			"r2_buckets": [
				{
					"binding": "DATOS_BUCKET",
					"bucket_name": "datos-autos"
				}
			]
		}
	}
}